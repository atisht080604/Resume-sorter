# AI-Powered Resume Screening System - Environment Configuration Template
# Copy this file to backend/.env or configure in your environment

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-to-a-secure-random-secret-key-in-production

# Database Configuration (Defaults to SQLite in backend/app/resume_screening.db)
DATABASE_URL=sqlite:///resume_screening.db

# NLP & Sentence-BERT Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_SKILL_THRESHOLD=0.70

# Server Binding
HOST=127.0.0.1
PORT=5000
